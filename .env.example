# Кількість потоків CPU для PyTorch та препроцесу.
# Типово: 80% потоків хоста, обрізаних до cgroup-квоти контейнера.
# Приклад для навантаженого хоста: 6
# TTS_THREADS=6

# Потоки intra-op для ONNX Runtime (генерація аудіо).
# Типово: min(TTS_THREADS, 9) — виміряно як найшвидше на CPU з кільцями.
# ORT_INTRA_THREADS=9

# Каталог кешу моделей (у docker-compose вже задано volume'ом).
# HF_HOME=/app/models
