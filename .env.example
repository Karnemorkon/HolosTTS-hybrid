# Кількість потоків CPU для PyTorch та препроцесу.
# Типово: 80% потоків хоста, обрізаних до cgroup-квоти контейнера.
# Приклад для навантаженого хоста: 6
# TTS_THREADS=6

# Потоки intra-op для ONNX Runtime (генерація аудіо).
# Типово: min(TTS_THREADS, 9) — виміряно як найшвидше на CPU з кільцями.
# ORT_INTRA_THREADS=9

# Каталог кешу моделей (у docker-compose вже задано volume'ом).
# HF_HOME=/app/models

# Наголошування: rule (типово, словниковий, швидший) | byt5 (нейромережевий
# ByT5-CT2: якісніший на рідкісних словах; перший виклик докачує ~1.2 ГБ і додає
# ~1-2 с на унікальне речення на CPU).
# HOLOS_STRESS=byt5

# Провайдер ONNX Runtime: auto (типово) | cpu | openvino | cuda.
# Для openvino/cuda збирайте образ з відповідним ORT_VARIANT (див. README).
# ORT_PROVIDER=openvino
